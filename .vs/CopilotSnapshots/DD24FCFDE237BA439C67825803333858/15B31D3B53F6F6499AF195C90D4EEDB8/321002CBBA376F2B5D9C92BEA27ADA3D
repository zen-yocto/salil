			(function(){
			function isClickableElement(el) {
			return el.tagName === 'A' || el.tagName === 'BUTTON' || el.closest('a') || el.closest('button');
			}

			document.querySelectorAll('.project-card').forEach(function(card){
			card.addEventListener('click', function(e){
			if (isClickableElement(e.target)) return;

			var details = card.querySelector('.project-details');
			var icon = card.querySelector('.expand-icon i');
			if (!details) return;

			details.classList.toggle('hidden');
			var expanded = !details.classList.contains('hidden');
			card.setAttribute('aria-expanded', expanded);

			if (icon) {
			icon.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
			}
			});

			card.addEventListener('keydown', function(e){
			if (e.key === 'Enter' || e.key === ' ') {
			if (isClickableElement(e.target)) return;
			e.preventDefault();
			card.click();
			}
			});
			});
			})();
